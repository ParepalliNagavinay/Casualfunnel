{
  "name": "insightflow-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight user analytics platform with an embeddable tracking SDK.",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "test": "npm --workspace server test && npm --workspace client test -- --run",
    "start": "npm --workspace server start"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
